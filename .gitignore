/.idea/
/.cursor/
/local-docs/
.DS_Store
# Claude Code local settings (but keep rules directory)
.claude/settings.local.json
# Code review reports (generated locally, not committed)
docs/reviews/
!docs/reviews/.gitkeep
**/.DS_Store
node_modules
/node_modules/
**/node_modules/
**/dist/
**/node_modules
.env
.env.local
env.local
n8n-dev-agent/.env
n8n-dev-agent/data/
localstorage/
.next/
**/cdk.out/
**/cdk-diff.out/
promptfoo-errors.log
packages/infra/resource-mapping.json

# Prevent nested workspace configs (only root should have pnpm-workspace.yaml)
apps/**/pnpm-workspace.yaml
packages/**/pnpm-workspace.yaml

# Build outputs
*.d.ts
*.js
!*.config.js
!*.cy.js
!jest.setup.js
!jest.setup.env.js
!jest.uuid-mock.js
!jest.config.js
!eslint.config.js
!next.config.js
!playwright.config.js
!postcss.config.js
!tailwind.config.js
!lighthouserc.js
/apps/web/tsconfig.tsbuildinfo

# Utility scripts (run locally, not deployed)
/scripts/

# Eval RFP fixtures (not committed)
**/sections-rfps/
**/rfp-texts/

# Local ticket tracking
.tickets/

# Daily progress notes
.daily-progress/
cypress.env.json
**/cypress.env.json

# Local credentials — never commit
ADMIN-CREDENTIALS.md

# Playwright artifacts (generated per run)
apps/web/playwright-report/
apps/web/test-results/
apps/web/e2e/.auth/
!apps/web/e2e/.auth/.gitkeep

# AI-DLC — only the shared method/memory (aidlc/spaces/*/memory/) and the code
# knowledge base (aidlc/spaces/*/codekb/) are committed. Per-intent workflow
# bookkeeping (questions, per-stage artifacts, audit shards, state) is
# machine-local: it stays on disk so /aidlc --resume works, but is not tracked.
# Each feature keeps a durable summary in docs/<FEATURE>-HANDOFF.md instead.
aidlc/active-space
aidlc/spaces/*/intents/
aidlc/.aidlc-clone-id
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/.aidlc-sessions/
aidlc/spaces/*/intents/.aidlc-*
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/

# Test coverage output
/apps/functions/coverage/
# TypeScript incremental build info (any location)
*.tsbuildinfo
